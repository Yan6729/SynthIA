# --- Général ---
PORT=3000
APP_URL=http://localhost:3000
NODE_ENV=development
DB_PATH=./data/manager.db
# 32 octets en base64 : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_KEY=

# --- E-mails (vérification, mot de passe oublié) : console (dev, écrit dans les logs) | resend ---
MAIL_MODE=console
RESEND_API_KEY=
MAIL_FROM=Synthia <no-reply@ton-domaine.com>
# Adresse affichée dans la page Aide (facultatif)
SUPPORT_EMAIL=
# 1 = une ligne JSON par requête (activé par défaut en production)
LOG_REQUESTS=

# --- IA (au moins un pour activer les textes IA) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
XAI_API_KEY=
XAI_MODEL=grok-4
AI_DEFAULT=claude
AI_DAILY_QUOTA=30

# --- Paiement en dollars : stripe | simulate (simulate interdit en production) ---
PAY_MODE=simulate
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Prix de PREMIUM pour 30 jours, en dollars (minimum 0.50)
PREMIUM_PRICE_USD=9

# --- Réseaux (laisser vide = mode démo pour ce réseau) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
