# --- Général ---
PORT=3000
APP_URL=http://localhost:3000
NODE_ENV=development
DB_PATH=./data/manager.db
# 32 octets en base64 : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_KEY=

# --- IA (au moins un pour activer les textes IA) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
XAI_API_KEY=
XAI_MODEL=grok-4
AI_DEFAULT=claude
AI_DAILY_QUOTA=30

# --- Paiement : fedapay | simulate (simulate interdit en production) ---
PAY_MODE=simulate
FEDAPAY_SECRET_KEY=
FEDAPAY_ENV=sandbox
FEDAPAY_WEBHOOK_SECRET=
PREMIUM_PRICE=5000

# --- Réseaux (laisser vide = mode démo pour ce réseau) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
